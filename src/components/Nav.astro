---
import Button from './ui/Button.astro';
import { t, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const links = [
  { href: '#experience', label: copy.nav.experience },
  { href: '#skills', label: copy.nav.skills },
  { href: '#work', label: copy.nav.work },
];
const other: Lang = lang === 'en' ? 'es' : 'en';
---

<!--
  State lives in data attributes set by scripts/motion.ts:
  [data-solid] on <nav> once we leave the top, [data-hidden] on <header> while scrolling down,
  and the indicator pill slides to the active/hovered link.
-->
<header data-nav-header class="fixed inset-x-0 top-4 z-50 px-4 transition-transform duration-500 ease-out data-[hidden]:-translate-y-[250%]">
  <nav
    data-nav
    class="mx-auto flex h-14 max-w-3xl items-center justify-between rounded-full border border-transparent pr-2 pl-4 transition-[background-color,border-color,box-shadow] duration-500 data-[solid]:border-line data-[solid]:bg-white/90 data-[solid]:shadow-[0_10px_30px_-12px_rgba(15,15,30,0.12)]"
  >
    <a href={localePath(lang)} class="text-sm font-semibold tracking-tight text-ink">Jesús Soares</a>

    <div class="relative hidden md:block" data-nav-links>
      <span
        data-nav-indicator
        class="absolute top-1/2 h-8 -translate-y-1/2 rounded-full bg-surface opacity-0 transition-[left,width,opacity] duration-300 ease-out"
        aria-hidden="true"
      ></span>
      <ul class="flex items-center">
        {
          links.map((link) => (
            <li class="relative">
              <a
                href={link.href}
                data-nav-link
                class="block rounded-full px-3.5 py-2 text-sm text-muted transition-colors duration-300 hover:text-ink data-[active]:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={localePath(other)}
        hreflang={other}
        lang={other}
        title={copy.nav.language}
        class="flex items-center gap-1.5 rounded-full px-2.5 py-2 font-mono text-xs text-muted uppercase transition-colors hover:text-ink"
      >
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
        </svg>
        {other}
      </a>
      <Button href="#contact" size="sm">{copy.nav.contact}</Button>
    </div>
  </nav>
</header>
