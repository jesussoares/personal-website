---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).work;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="mx-auto max-w-6xl px-4 py-28 sm:px-8 md:py-40">
  <SectionHeading label={copy.label} title={copy.title} />

  {
    projects.length === 0 ? (
      <div class="relative overflow-hidden rounded-3xl bg-surface px-7 py-20 text-center md:py-28" data-reveal>
        <div
          class="pointer-events-none absolute -top-40 left-1/2 size-[28rem] -translate-x-1/2 opacity-25"
          style="background: radial-gradient(closest-side, var(--accent-a), color-mix(in srgb, var(--accent-b) 40%, transparent) 55%, transparent)"
          aria-hidden="true"
        />
        <div class="relative mx-auto flex w-fit gap-1.5" aria-hidden="true">
          {[0, 1, 2].map((i) => (
            <span
              class="size-2 animate-pulse rounded-full bg-gradient-to-r from-accent-a to-accent-b"
              style={`animation-delay: ${i * 200}ms`}
            />
          ))}
        </div>
        <h3 class="relative mt-6 text-2xl font-medium tracking-tight text-ink md:text-3xl">{copy.emptyTitle}</h3>
        <p class="relative mx-auto mt-3 max-w-md text-muted">{copy.emptyText}</p>
      </div>
    ) : (
      <ul class="grid gap-4 md:grid-cols-2">
        {projects.map(({ data }) => (
          <li class="group flex min-h-64 flex-col rounded-3xl bg-surface p-7 transition-colors hover:bg-surface-strong md:p-9" data-reveal>
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-2xl font-medium tracking-tight text-ink">{data.title[lang]}</h3>
              {data.year && <span class="font-mono text-xs text-muted">{data.year}</span>}
            </div>
            <p class="mt-3 leading-relaxed text-muted">{data.summary[lang]}</p>
            <ul class="mt-auto flex flex-wrap gap-2 pt-6">
              {data.tags.map((tag) => (
                <li class="rounded-full bg-white px-3 py-1 text-xs text-muted">{tag}</li>
              ))}
            </ul>
            {(data.url || data.repo) && (
              <div class="mt-6 flex gap-2">
                {data.url && (
                  <a href={data.url} target="_blank" rel="noopener" class="rounded-full bg-ink px-4 py-2 text-sm text-white hover:opacity-85">
                    {copy.live} ↗
                  </a>
                )}
                {data.repo && (
                  <a href={data.repo} target="_blank" rel="noopener" class="rounded-full bg-white px-4 py-2 text-sm text-ink hover:bg-surface-strong">
                    {copy.code} ↗
                  </a>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>
    )
  }
</section>
