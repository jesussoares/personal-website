---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div class="mb-12 md:mb-16" data-reveal>
  <p class="flex items-center gap-2 font-mono text-xs tracking-wider text-muted uppercase">
    <span class="size-1.5 rounded-full bg-gradient-to-r from-accent-a to-accent-b"></span>
    {label}
  </p>
  <h2 class="mt-4 max-w-2xl text-4xl leading-[1.05] font-medium tracking-[-0.035em] text-ink md:text-6xl">{title}</h2>
</div>
