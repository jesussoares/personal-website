---
import SectionHeading from './SectionHeading.astro';
import { t, type Lang } from '../i18n/ui';
import { roles } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).experience;
---

<section id="experience" class="mx-auto max-w-6xl px-4 pt-16 pb-28 sm:px-8 md:pt-20 md:pb-40">
  <SectionHeading label={copy.label} title={copy.title} />

  <ol class="space-y-4">
    {
      roles.map((v) => (
        <li class="grid gap-6 rounded-3xl bg-surface p-7 md:grid-cols-[14rem_1fr] md:gap-10 md:p-10" data-reveal>
          <div>
            <p class="font-mono text-xs text-muted">{v.period[lang]}</p>
            <h3 class="mt-3 text-2xl font-medium tracking-tight text-ink">{v.company}</h3>
            <p class="mt-1 text-sm text-muted">{v.role[lang]}</p>
            <p class="text-sm text-muted">{v.place[lang]}</p>
          </div>
          <div>
            <ul class="space-y-3">
              {v.points[lang].map((point) => (
                <li class="relative pl-5 leading-relaxed text-ink/80 before:absolute before:top-[0.65em] before:left-0 before:size-1.5 before:rounded-full before:bg-line">
                  {point}
                </li>
              ))}
            </ul>
            {v.tags && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {v.tags.map((tag) => (
                  <li class="rounded-full bg-white px-3 py-1 text-xs text-muted">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
