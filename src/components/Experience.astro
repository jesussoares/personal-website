---
import SectionHeading from './SectionHeading.astro';
import { t, type Lang } from '../i18n/ui';
import { roles } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).experience;
---

<section id="experience" class="mx-auto max-w-6xl px-4 pt-16 pb-28 sm:px-8 md:pt-20 md:pb-40">
  <SectionHeading label={copy.label} title={copy.title} />

  <!-- Roadmap: dashed track with a gradient fill driven by scroll; nodes light up when the fill reaches them -->
  <ol class="relative" data-roadmap>
    <div class="roadmap-track absolute top-2 bottom-2 left-[11px] w-px md:left-1/2" aria-hidden="true">
      <div
        class="absolute inset-y-0 left-1/2 w-[3px] -translate-x-1/2 origin-top bg-gradient-to-b from-accent-a to-accent-b opacity-50 blur-[3px]"
        data-roadmap-fill
      >
      </div>
      <div
        class="absolute inset-y-0 left-1/2 w-[2px] -translate-x-1/2 origin-top rounded-full bg-gradient-to-b from-accent-a to-accent-b"
        data-roadmap-fill
      >
      </div>
    </div>

    {
      roles.map((v, i) => {
        const cardRight = i % 2 === 0;
        return (
          <li class="group relative grid pb-16 pl-10 last:pb-0 md:grid-cols-2 md:gap-20 md:pl-0" data-roadmap-item>
            {/* Node */}
            <span
              class="absolute top-7 left-0 grid size-[23px] place-items-center rounded-full border border-line bg-white transition-colors duration-500 group-data-[active]:border-accent-a md:left-1/2 md:-translate-x-1/2"
              aria-hidden="true"
            >
              <span class="absolute inset-0 rounded-full border border-accent-a opacity-0 group-data-[active]:animate-[node-burst_0.9s_ease-out]" />
              <span class="size-2 rounded-full bg-line transition-all duration-500 group-data-[active]:scale-125 group-data-[active]:bg-gradient-to-br group-data-[active]:from-accent-a group-data-[active]:to-accent-b" />
            </span>

            {/* Date side (desktop) */}
            <div class:list={['hidden pt-6 md:block', cardRight ? 'text-right' : 'md:order-2']}>
              <p class="font-mono text-sm text-ink">{v.period[lang]}</p>
              <p class="mt-1 text-sm text-muted">{v.place[lang]}</p>
            </div>

            {/* Card: 1px wrapper acts as the border; a cursor-following gradient lights it up on hover */}
            <div
              class:list={[
                'group/card relative rounded-3xl bg-line p-px transition-[background-color,box-shadow] duration-500 group-data-[active]:bg-accent-a/25 group-data-[active]:shadow-[0_16px_50px_-12px_rgba(79,124,255,0.18)]',
                !cardRight && 'md:order-1',
              ]}
              data-roadmap-card
              data-spotlight
              data-side={cardRight ? 'right' : 'left'}
            >
              <div
                class="pointer-events-none absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
                style="background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 50%), var(--accent-a), var(--accent-b) 30%, transparent 70%)"
              />
              <article class="relative overflow-hidden rounded-[calc(1.5rem-1px)] bg-white p-7 md:p-8">
                <div
                  class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
                  style="background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent-a) 6%, transparent), transparent 60%)"
                />

                <p class="relative mb-2 font-mono text-xs text-muted md:hidden">
                  {v.period[lang]} · {v.place[lang]}
                </p>
                <h3 class="relative text-xl font-medium tracking-tight text-ink md:text-2xl">{v.company}</h3>
                <p class="relative mt-0.5 text-sm text-muted">{v.role[lang]}</p>

                <ul class="relative mt-6 space-y-2.5">
                  {v.points[lang].map((point) => (
                    <li class="relative pl-5 text-[15px] leading-relaxed text-ink/80 before:absolute before:top-[0.65em] before:left-0 before:size-1.5 before:rounded-full before:bg-gradient-to-br before:from-accent-a before:to-accent-b before:opacity-60">
                      {point}
                    </li>
                  ))}
                </ul>

                {v.tags && (
                  <ul class="relative mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
                    {v.tags.map((tag) => (
                      <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">{tag}</li>
                    ))}
                  </ul>
                )}
              </article>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
