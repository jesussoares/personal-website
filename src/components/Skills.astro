---
import SectionHeading from './SectionHeading.astro';
import { t, type Lang } from '../i18n/ui';
import { disciplines } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).skills;
---

<section id="skills" class="mx-auto max-w-6xl px-4 py-28 sm:px-8 md:py-40">
  <SectionHeading label={copy.label} title={copy.title} />

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      disciplines.map((d) => (
        <article class="rounded-3xl bg-surface p-7 md:p-8" data-reveal>
          <h3 class="text-lg font-medium tracking-tight text-ink">{d.title[lang]}</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {d.items.map((item) => (
              <li class="rounded-full bg-white px-3.5 py-1.5 text-sm text-ink/80 transition-colors hover:text-ink">
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
